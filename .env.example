# VELOX runs without any variables: catalogue + all tools work, data stays on the visitor's device,
# and AI / account features say clearly when they are not connected.

# ---------------------------------------------------------------- Accounts (Supabase Auth)
# Public by design: the project URL and the "anon" key. Personal data is protected by row-level
# security in the database (supabase/schema.sql). NEVER put the service_role key here or in any
# NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL used in email links and OAuth redirects, e.g. https://velox.example
NEXT_PUBLIC_SITE_URL=
# Set to "false" to hide the Google button until Google is enabled in the Supabase dashboard.
# The Google OAuth client ID and secret are entered in Supabase (Authentication → Providers →
# Google), not here — they never reach this app's code.
NEXT_PUBLIC_AUTH_GOOGLE=

# ---------------------------------------------------------------- Images (optional)
# CDN or Supabase Storage public bucket URL that mirrors /media/products,
# e.g. https://<project>.supabase.co/storage/v1/object/public/product-images
NEXT_PUBLIC_IMAGE_BASE=

# ---------------------------------------------------------------- AI (server only)
# Language + vision provider for AI Mechanic (Anthropic). Optional.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
VELOX_AI_MODEL=
# Image generation for AI Bike Visualizer — any provider behind a small HTTP gateway.
# Contract: POST { prompt, negative_prompt, n, reference_image? } -> { images: [{ b64 | url }] }
VELOX_IMAGE_API_URL=
VELOX_IMAGE_API_KEY=
