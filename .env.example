# VELOX runs without any variables: catalogue + all tools work locally, and AI features
# report "not connected" instead of pretending. Set these on the SERVER only — never expose
# them with a NEXT_PUBLIC_ prefix.

# Language + vision provider for AI Mechanic (Anthropic). Optional.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
VELOX_AI_MODEL=

# Image generation for AI Bike Visualizer — any provider behind a small HTTP gateway.
# Contract: POST { prompt, negative_prompt, n, reference_image? } -> { images: [{ b64 | url }] }
VELOX_IMAGE_API_URL=
VELOX_IMAGE_API_KEY=

# Reserved for the Supabase backend (see supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
